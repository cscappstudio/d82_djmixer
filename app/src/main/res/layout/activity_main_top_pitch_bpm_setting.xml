<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bpm_setting_layout"
    android:background="@color/top_layout_fg_color"
    android:paddingLeft="@dimen/bpm_setting_layout_padding_h"
    android:paddingTop="@dimen/bpm_setting_layout_padding_v"
    android:paddingRight="@dimen/bpm_setting_layout_padding_h"
    android:paddingBottom="@dimen/bpm_setting_layout_padding_v"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/bpm_setting_layout_padding_h"
    android:paddingVertical="@dimen/bpm_setting_layout_padding_v">
    <TextView
        android:textSize="@dimen/pitch_btn_text_size"
        android:textColor="@color/pitch_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/bpm_setting_reset"
        android:background="@drawable/pitch_bg_selector_left"
        android:layout_width="@dimen/pitch_btn_reset_with"
        android:layout_height="match_parent"
        android:text="@string/reset_2"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/pitch_btn_text_size"
        android:textColor="@color/pitch_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/bpm_setting_apply"
        android:background="@drawable/pitch_bg_selector_left"
        android:layout_width="@dimen/pitch_btn_reset_with"
        android:layout_height="match_parent"
        android:text="@string/ok"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.ijoysoft.mix.view.BpmSettingPreviewView
        android:id="@+id/bpm_setting_preview"
        android:layout_width="0dp"
        android:layout_height="@dimen/bpm_setting_preview_height"
        android:layout_marginLeft="@dimen/bpm_setting_preview_margin_h"
        android:layout_marginRight="@dimen/bpm_setting_preview_margin_h"
        android:layout_marginHorizontal="@dimen/bpm_setting_preview_margin_h"
        app:bpmLineNormalColor="#1aedf8ff"
        app:bpmLineSelectedColor="@color/theme_color_left"
        app:bpmLineSpacing="@dimen/bpm_setting_preview_line_spacing"
        app:layout_constraintBottom_toTopOf="@+id/tap_layout"
        app:layout_constraintEnd_toStartOf="@+id/bpm_setting_apply"
        app:layout_constraintStart_toEndOf="@+id/bpm_setting_reset"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tap_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/bpm_setting_preview"
        app:layout_constraintStart_toStartOf="@+id/bpm_setting_preview"
        app:layout_constraintTop_toBottomOf="@+id/bpm_setting_preview">
        <TextView
            android:textSize="@dimen/bpm_setting_tap_text_size"
            android:textColor="@color/theme_color_left"
            android:gravity="center"
            android:id="@+id/bpm_setting_tap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="TAP"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@+id/bpm_setting_bpm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/bpm_setting_bpm_text_size"
            android:textColor="@color/primary_color"
            android:gravity="center"
            android:id="@+id/bpm_setting_bpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="BPM"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bpm_setting_tap"/>
        <TextView
            android:textSize="@dimen/bpm_setting_tap_text_size"
            android:textColor="@color/theme_color_left"
            android:gravity="center"
            android:id="@+id/bpm_setting_minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:minHeight="24dp"
            android:text="/2"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bpm_setting_tap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/bpm_setting_tap_text_size"
            android:textColor="@color/theme_color_left"
            android:gravity="center"
            android:id="@+id/bpm_setting_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:minHeight="24dp"
            android:text="x2"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bpm_setting_tap"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
