<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guide_tap_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ijoysoft.mix.view.guide.GuideTapView
        android:id="@+id/guide_tap_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:TapCorners="4dp"
        app:TapMaskColor="#80000000"
        app:TapStrokeAnimationDuration="2000"
        app:TapStrokeColor="#ffffcc00"
        app:TapStrokeWidth="2dp"/>
    <com.ijoysoft.mix.view.guide.TapArrowView
        android:id="@+id/arrow_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:TapArrowCorners="8dp"
        app:TapArrowSpacing="4dp"
        app:TapArrowTint="#00b4ff"
        app:TapReservedSpacing="8dp"
        app:TapTextColor="@color/white"
        app:TapTextSize="@dimen/sp_18"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/skip_view"
        android:background="#546bb5"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/sw_dp_36"
        android:layout_marginTop="@dimen/sw_dp_20"
        android:layout_marginEnd="@dimen/sw_dp_24"
        android:paddingHorizontal="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_fx"
            android:background="@drawable/vector_beat_item_bg_selector_right"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/vector_mixer_guide_skip"/>
        <TextView
            android:textSize="@dimen/sw_sp_15"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/skip_lesson"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</FrameLayout>
