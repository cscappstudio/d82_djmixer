<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/tool_layout_bg"
    android:paddingLeft="@dimen/loop_layout_padding_h"
    android:paddingTop="@dimen/loop_layout_padding_v"
    android:paddingRight="@dimen/loop_layout_padding_h"
    android:paddingBottom="@dimen/loop_layout_padding_v"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/loop_layout_margin_h"
    android:layout_marginRight="@dimen/loop_layout_margin_h"
    android:layout_marginHorizontal="@dimen/loop_layout_margin_h"
    android:paddingHorizontal="@dimen/loop_layout_padding_h"
    android:paddingVertical="@dimen/loop_layout_padding_v">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loop_button_height">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/arrow_left"
            android:background="@drawable/loop_btn_left_selector_left"
            android:padding="@dimen/loop_button_arrow_padding"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="@drawable/vector_arrow_loop_left"
            app:tint="@color/loop_text_color_selector_left"/>
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/current_loop"
            android:background="@drawable/loop_btn_middle_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="0"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/arrow_right"
            android:background="@drawable/loop_btn_right_selector_left"
            android:padding="@dimen/loop_button_arrow_padding"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="@drawable/vector_arrow_loop_right"
            app:tint="@color/loop_text_color_selector_left"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loop_button_height_middle"
        android:layout_marginTop="@dimen/loop_button_margin">
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_8"
            android:background="@drawable/loop_num_top_left_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="8"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_4"
            android:background="@drawable/loop_num_top_middle_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="4"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_2"
            android:background="@drawable/loop_num_top_right_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="2"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loop_button_height_middle">
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_1"
            android:background="@drawable/loop_num_bottom_left_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_1_2"
            android:background="@drawable/loop_num_bottom_middle_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="1/2"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/loop_button_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_1_4"
            android:background="@drawable/loop_num_bottom_right_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="1/4"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loop_button_height"
        android:layout_marginTop="@dimen/loop_button_margin">
        <TextView
            android:textSize="@dimen/loop_button_in_out_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_in"
            android:background="@drawable/loop_btn_big_left_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="IN 00:00"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/loop_button_in_out_text_size"
            android:textColor="@color/loop_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/loop_out"
            android:background="@drawable/loop_btn_big_right_selector_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="OUT 02:08"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
    </LinearLayout>
</LinearLayout>
