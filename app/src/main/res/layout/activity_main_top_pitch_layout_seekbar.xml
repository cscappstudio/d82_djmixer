<?xml version="1.0" encoding="utf-8"?>
<com.ijoysoft.mix.view.BPMSeekBar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:id="@+id/seekbar_pitch"
    android:background="@color/pitch_seekbar_background_color"
    android:paddingLeft="@dimen/pitch_seekbar_padding_h"
    android:paddingTop="@dimen/pitch_seekbar_padding_v"
    android:paddingRight="@dimen/pitch_seekbar_padding_h"
    android:paddingBottom="@dimen/pitch_seekbar_padding_v"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pitch_seekbar_height"
    android:paddingHorizontal="@dimen/pitch_seekbar_padding_h"
    android:paddingVertical="@dimen/pitch_seekbar_padding_v"
    app:seekAdsorptionProgress="@integer/seekbar_adsorption_progress"
    app:seekAdsorptionRadius="@integer/seekbar_adsorption_radius"
    app:seekProgressBgColor="@color/pitch_seekbar_progress_bg_color"
    app:seekProgressColorLeftBottom="@color/theme_color_left"
    app:seekProgressColorRightTop="@color/theme_color_left"
    app:seekProgressSize="2.5dp"
    app:seekProgressThumb="@drawable/seekbar_thumb_h_pitch_selector_left"
    app:seekScaleLineColor="@color/pitch_seekbar_scale_line_color"
    app:seekScaleLinePressedColor="@color/pitch_seekbar_scale_line_color_pressed"
    app:seekScaleLineShortColor="@color/pitch_seekbar_scale_line_color_short"
    app:seekScaleLineShortPressedColor="@color/pitch_seekbar_scale_line_color_short_pressed"
    app:seekScaleLineSpacing="@dimen/pitch_seekbar_scale_line_spacing"
    app:seekScaleLineWidth="@dimen/pitch_seekbar_scale_line_width"
    app:seekScaleNum="7"
    app:seekSymmetryMode="true"
    app:seekTextSize="@dimen/pitch_seekbar_text_size"
    app:seekThumbEdgeAlign="true"/>
