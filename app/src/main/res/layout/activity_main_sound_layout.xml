<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sound_layout"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/card_surface_bg_large"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/sound_layout_2"
        app:layout_constraintStart_toStartOf="@+id/sound_layout_2"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/sound_layout_2"
        android:paddingLeft="@dimen/sound_layout_padding_h"
        android:paddingTop="@dimen/sound_layout_padding_v"
        android:paddingRight="@dimen/sound_layout_padding_h"
        android:paddingBottom="@dimen/sound_layout_padding_v"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/sound_layout_padding_h"
        android:paddingVertical="@dimen/sound_layout_padding_v"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sound_button_margin_bottom">
            <com.ijoysoft.mix.view.SelectBox
                android:id="@+id/sound_left"
                android:background="@drawable/sound_button_bg_selector"
                android:padding="@dimen/sound_button_padding"
                android:layout_width="@dimen/sound_button_width"
                android:layout_height="@dimen/sound_button_height"
                app:srcCompat="@drawable/sound_boost_selector_left"/>
            <com.ijoysoft.mix.view.SelectBox
                android:id="@+id/sound_right"
                android:background="@drawable/sound_button_bg_selector"
                android:padding="@dimen/sound_button_padding"
                android:layout_width="@dimen/sound_button_width"
                android:layout_height="@dimen/sound_button_height"
                android:layout_marginStart="@dimen/sound_button_margin_center"
                app:srcCompat="@drawable/sound_boost_selector_right"/>
        </LinearLayout>
        <include
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            layout="@layout/activity_main_sound_seek_layout"/>
        <LinearLayout
            android:id="@+id/sound_ad_menu_layout"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sound_button_margin_top">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/setting"
                android:background="@drawable/sound_button_bg_selector"
                android:padding="@dimen/sound_button_padding"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="@dimen/sound_button_width"
                android:layout_height="@dimen/sound_button_height"
                app:srcCompat="@drawable/vector_ds_setting"
                app:tint="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/card_surface_bg"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/sync_left"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sync"
                android:layout_weight="1"
                android:textAlignment="center"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#2E374D" />
            <TextView
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/sync_right"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sync"
                android:layout_weight="1"
                android:textAlignment="center"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
