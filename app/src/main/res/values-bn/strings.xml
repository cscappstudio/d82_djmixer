    <string name="intro_slide_1_title">আপনার সংগীত, আপনার মিক্স</string>
    <string name="intro_slide_1_des">আপনার পছন্দের ট্র্যাকগুলোকে অনন্য মিক্সে রূপান্তর করুন এবং আপনার নিজস্ব সুর তৈরি করুন।</string>
    <string name="intro_slide_2_title">প্রোদের মতো মিক্স করুন</string>
    <string name="intro_slide_2_des">সহজ ডিজে নিয়ন্ত্রণের মাধ্যমে ট্র্যাক মিশ্রণ করুন, বিট সামঞ্জস্য করুন এবং প্রতিটি শব্দ নিখুঁত করুন।</string>
    <string name="intro_slide_3_title">আপনার নিজস্ব সাউন্ড যোগ করুন</string>
    <string name="intro_slide_3_des">সৃজনশীল সাউন্ড ইফেক্ট অন্বেষণ করুন, বিট তৈরি করুন এবং প্রতিটি মিক্সকে অনন্য করে তুলুন।</string>
    <string name="intro_slide_4_title">বিট অনুভব করুন। মিক্সের নিয়ন্ত্রণ নিন।</string>
    <string name="intro_slide_4_des">আপনার সঙ্গীতে প্রাণ দিন এবং যেকোনো সময়, যেকোনো স্থানে আপনার ডিজে যাত্রা শুরু করুন।</string>
