<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_social"
    android:padding="8dp">

    <!-- Shimmer Media Thumbnail on Left -->
    <View
        android:id="@+id/shimmer_media"
        android:layout_width="110dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_thumb_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shimmer Icon -->
    <View
        android:id="@+id/shimmer_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_thumb_placeholder"
        app:layout_constraintStart_toEndOf="@+id/shimmer_media"
        app:layout_constraintTop_toTopOf="@+id/shimmer_media" />

    <!-- Shimmer Headline -->
    <View
        android:id="@+id/shimmer_title"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_thumb_placeholder"
        app:layout_constraintBottom_toBottomOf="@+id/shimmer_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/shimmer_icon"
        app:layout_constraintTop_toTopOf="@+id/shimmer_icon" />

    <!-- Shimmer Body Line 1 -->
    <View
        android:id="@+id/shimmer_body"
        android:layout_width="0dp"
        android:layout_height="11dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_thumb_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/shimmer_media"
        app:layout_constraintTop_toBottomOf="@+id/shimmer_icon" />

    <!-- Shimmer Body Line 2 -->
    <View
        android:id="@+id/shimmer_body2"
        android:layout_width="90dp"
        android:layout_height="10dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_thumb_placeholder"
        app:layout_constraintStart_toEndOf="@+id/shimmer_media"
        app:layout_constraintTop_toBottomOf="@+id/shimmer_body" />

    <!-- Shimmer Button -->
    <View
        android:id="@+id/shimmer_btn"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_thumb_placeholder"
        app:layout_constraintBottom_toBottomOf="@+id/shimmer_media"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/shimmer_media" />

</androidx.constraintlayout.widget.ConstraintLayout>
