<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:paddingHorizontal="@dimen/bottom_layout_padding_h"
    android:paddingVertical="@dimen/bottom_layout_padding_v">

    <com.ijoysoft.mix.view.CrossFadeSeekBar
        android:id="@+id/seekbar_cross"
        android:layout_width="153dp"
        android:layout_height="@dimen/cross_seekbar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:seekAdsorptionProgress="@integer/seekbar_adsorption_progress"
        app:seekAdsorptionRadius="@integer/seekbar_adsorption_radius"
        app:seekAllowClick="true"
        app:seekProgressBgColor="@color/cross_seekbar_progress_bg_color"
        app:seekProgressColorLeftBottom="@color/theme_color_left"
        app:seekProgressColorRightTop="@color/theme_color_right"
        app:seekProgressSize="@dimen/cross_seekbar_progress_size"
        app:seekProgressThumb="@drawable/seekbar_thumb_h_selector"
        app:seekScaleLineColor="@color/cross_seekbar_scale_line_color"
        app:seekScaleLinePressedColor="@color/cross_seekbar_scale_line_color_pressed"
        app:seekScaleLineShortColor="@color/cross_seekbar_scale_line_color_short"
        app:seekScaleLineShortPressedColor="@color/cross_seekbar_scale_line_color_short_pressed"
        app:seekScaleLineSpacing="@dimen/cross_seekbar_scale_line_spacing"
        app:seekScaleNum="7"
        app:seekSymmetryMode="true"
        app:seekTextSize="@dimen/cross_seekbar_text_size"
        app:seekThumbEdgeAlign="true"
        app:seekThumbEdgeShadowRatio="0.1" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrow_left"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/seekbar_cross"
        app:layout_constraintEnd_toStartOf="@+id/seekbar_cross"
        app:layout_constraintTop_toTopOf="@+id/seekbar_cross"
        app:srcCompat="@drawable/vector_arrow_left"
        app:tint="@color/bottom_arrow_color_selector_left" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrow_right"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/seekbar_cross"
        app:layout_constraintStart_toEndOf="@+id/seekbar_cross"
        app:layout_constraintTop_toTopOf="@+id/seekbar_cross"
        app:srcCompat="@drawable/vector_arrow_right"
        app:tint="@color/bottom_arrow_color_selector_right" />

    <include
        android:id="@+id/bottom_layout_left"
        layout="@layout/activity_main_bottom_layout_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/bottom_layout_right"
        layout="@layout/activity_main_bottom_layout_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
