<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:drawable="@drawable/sample_bg_6"/>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/sample_item_overlay_radius"/>
                    <solid android:color="@color/btn_pressed_overlay_color"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item
        android:state_pressed="false"
        android:drawable="@drawable/sample_bg_6"/>
</selector>
