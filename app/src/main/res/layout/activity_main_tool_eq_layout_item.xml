<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/eq_seekbar_top_text_size"
        android:textColor="@color/theme_color_left"
        android:id="@+id/equalizer_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"/>
    <com.ijoysoft.mix.view.CustomSeekBar
        android:id="@+id/equalizer_item_seek"
        android:background="@drawable/seekbar_bg_eq"
        android:paddingLeft="@dimen/eq_seekbar_padding_h"
        android:paddingTop="@dimen/eq_seekbar_padding_v"
        android:paddingRight="@dimen/eq_seekbar_padding_h"
        android:paddingBottom="@dimen/eq_seekbar_padding_v"
        android:layout_width="@dimen/eq_seekbar_width"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/eq_seekbar_margin_top"
        android:layout_marginBottom="@dimen/eq_seekbar_margin_bottom"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/eq_seekbar_padding_h"
        android:paddingVertical="@dimen/eq_seekbar_padding_v"
        app:seekAdsorptionProgress="@integer/seekbar_adsorption_progress"
        app:seekAdsorptionRadius="@integer/seekbar_adsorption_radius"
        app:seekProgressBgColor="@color/eq_seekbar_progress_bg_color"
        app:seekProgressColor="@color/theme_color_left"
        app:seekProgressSize="@dimen/eq_seekbar_progress_size"
        app:seekProgressThumb="@drawable/seekbar_thumb_v_left"
        app:seekScaleLineColor="@color/eq_seekbar_scale_line_color"
        app:seekScaleLinePressedColor="@color/eq_seekbar_scale_line_color_pressed"
        app:seekScaleLineShortColor="@color/eq_seekbar_scale_line_color_short"
        app:seekScaleLineShortPressedColor="@color/eq_seekbar_scale_line_color_short_pressed"
        app:seekTextSize="@dimen/eq_seekbar_text_size"
        app:seekThumbEdgeAlign="true"
        app:seekThumbEdgeShadowRatio="0.1"
        app:seekVerticalMode="true"/>
    <TextView
        android:textSize="@dimen/eq_seekbar_bottom_text_size"
        android:textColor="@color/primary_color"
        android:id="@+id/equalizer_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="31"/>
</LinearLayout>
