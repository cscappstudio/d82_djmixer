<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Banner Container -->
    <FrameLayout
        android:id="@+id/fl_top_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Top Navigation Toolbar -->
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1b1d22"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/vector_menu_back"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- Source Selector Button: Device / Online -->
        <LinearLayout
            android:id="@+id/btn_source_selector"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_selector_type_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/img_source_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_device_phone_white" />

            <TextView
                android:id="@+id/txt_source_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="@string/source_device"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- Deck Badge: DECK A / DECK B -->
        <TextView
            android:id="@+id/txt_deck_badge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_deck_badge"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="DECK A"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Search box -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <EditText
                android:id="@+id/edt_search"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:textColorHint="#77ffffff"
                android:hint="@string/search_local_tracks"
                android:paddingStart="32dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_dialog_round"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ImageView
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/vector_menu_search"/>
        </FrameLayout>

        <!-- Music Guide Button -->
        <FrameLayout
            android:id="@+id/btn_music_guide"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_help_guide" />
        </FrameLayout>
    </LinearLayout>

    <!-- Custom Category Tabs Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#16181d">

        <!-- Custom Category Tabs (Device Mode) -->
        <LinearLayout
            android:id="@+id/layout_device_tabs"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/tab_container_tracks"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tab_tracks"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#39C9E1"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/tab_tracks"/>

                <View
                    android:id="@+id/indicator_tab_tracks"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="#39C9E1"
                    android:visibility="visible"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_container_folders"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tab_folders"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/tab_folders"/>

                <View
                    android:id="@+id/indicator_tab_folders"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="#39C9E1"
                    android:visibility="invisible"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_container_recordings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tab_recordings"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/tab_recordings"/>

                <View
                    android:id="@+id/indicator_tab_recordings"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:background="#39C9E1"
                    android:visibility="invisible"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Online Genre Filter Tabs -->
        <HorizontalScrollView
            android:id="@+id/layout_online_tabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layout_online_tabs_container"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </FrameLayout>

    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#262932"/>

    <!-- Main Content List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_audio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>

        <!-- Loading State for Online -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/theme_color" />

            <TextView
                android:textSize="13sp"
                android:textColor="#88ffffff"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_online_tracks"/>
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="119dp"
                android:alpha="0.4"
                android:src="@drawable/vector_default_music"/>

            <TextView
                android:id="@+id/txt_empty"
                android:textSize="14sp"
                android:textColor="#66ffffff"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_device_tracks"/>
        </LinearLayout>

        <!-- Permission Request State for Device Mode -->
        <LinearLayout
            android:id="@+id/layout_permission"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/img_permission_icon"
                android:layout_width="140dp"
                android:layout_height="130dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_permission_music_folder"/>

            <TextView
                android:id="@+id/txt_permission_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#A0A5B5"
                android:textSize="14sp"
                android:text="@string/permission_storage_desc"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_allow_access"
                android:layout_width="wrap_content"
                android:minWidth="280dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_allow_access"
                android:text="@string/allow_access"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Jamendo attribution footer -->
    <TextView
        android:id="@+id/txt_jamendo_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#14171E"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/jamendo_attribution"
        android:textColor="#6B7280"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
