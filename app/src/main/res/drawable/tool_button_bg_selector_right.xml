<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <selector>
            <item android:state_pressed="true" android:drawable="@drawable/card_surface_bg_selected_pressed_right"/>
            <item android:state_pressed="false" android:drawable="@drawable/card_surface_bg_selected_right"/>
        </selector>
    </item>
    <item android:state_selected="false">
        <selector>
            <item android:state_pressed="true" android:drawable="@drawable/card_surface_bg_pressed"/>
            <item android:state_pressed="false" android:drawable="@drawable/card_surface_bg"/>
        </selector>
    </item>
</selector>
