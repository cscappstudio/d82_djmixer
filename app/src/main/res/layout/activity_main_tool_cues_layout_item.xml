<?xml version="1.0" encoding="utf-8"?>
<com.ijoysoft.music.view.square.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/cues_item_name_text_size"
        android:textColor="@color/black"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cues_item_padding_h"
        android:layout_marginTop="@dimen/cues_item_padding_v"
        android:layout_marginRight="@dimen/cues_item_padding_h"
        android:layout_marginBottom="@dimen/cues_item_padding_v"
        android:text="A"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/cues_item_padding_h"
        android:layout_marginVertical="@dimen/cues_item_padding_v"/>
    <TextView
        android:textSize="@dimen/cues_item_time_text_size"
        android:textColor="@color/black"
        android:layout_gravity="start|bottom"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cues_item_padding_h"
        android:layout_marginTop="@dimen/cues_item_padding_v"
        android:layout_marginRight="@dimen/cues_item_padding_h"
        android:layout_marginBottom="@dimen/cues_item_padding_v"
        android:text="00:00"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/cues_item_padding_h"
        android:layout_marginVertical="@dimen/cues_item_padding_v"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/delete"
        android:layout_width="@dimen/cues_item_delete_size"
        android:layout_height="@dimen/cues_item_delete_size"
        android:layout_marginLeft="@dimen/cues_item_padding_h"
        android:layout_marginTop="@dimen/cues_item_padding_v"
        android:layout_marginRight="@dimen/cues_item_padding_h"
        android:layout_marginBottom="@dimen/cues_item_padding_v"
        android:layout_marginHorizontal="@dimen/cues_item_padding_h"
        android:layout_marginVertical="@dimen/cues_item_padding_v"
        app:srcCompat="@drawable/vector_delete_cues"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/lock"
        android:background="@drawable/cues_lock_bg"
        android:paddingLeft="@dimen/cues_item_padding_h"
        android:paddingTop="@dimen/cues_item_padding_v"
        android:paddingRight="@dimen/cues_item_padding_h"
        android:paddingBottom="@dimen/cues_item_padding_v"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/cues_item_padding_h"
        android:paddingVertical="@dimen/cues_item_padding_v">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/cues_item_delete_size"
            android:layout_height="@dimen/cues_item_delete_size"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/vector_cues_lock"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cues_item_lock_text_size"
            android:textColor="#fff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unlock"
            android:singleLine="true"/>
            <TextView
            android:id="@+id/tag_ad_cues_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_ad_badge_corner"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="AD"
            android:textColor="#FFFFFF"
            android:textSize="7sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.ijoysoft.music.view.square.SquareFrameLayout>
