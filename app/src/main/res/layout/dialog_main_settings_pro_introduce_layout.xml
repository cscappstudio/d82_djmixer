<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/vip_introduce_icon_size"
            android:layout_height="@dimen/vip_introduce_icon_size"
            app:srcCompat="@drawable/vip_introduce_checked"/>
        <TextView
            android:textSize="@dimen/vip_introduce_text_size"
            android:textColor="@color/vip_introduce_message_color"
            android:id="@+id/vip_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vip_introduce_message1"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/vip_introduce_text_margin_start"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vip_introduce_spacing_v">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/vip_introduce_icon_size"
            android:layout_height="@dimen/vip_introduce_icon_size"
            app:srcCompat="@drawable/vip_introduce_checked"/>
        <TextView
            android:textSize="@dimen/vip_introduce_text_size"
            android:textColor="@color/vip_introduce_message_color"
            android:id="@+id/vip_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vip_introduce_message2"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/vip_introduce_text_margin_start"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vip_introduce_spacing_v">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/vip_introduce_icon_size"
            android:layout_height="@dimen/vip_introduce_icon_size"
            app:srcCompat="@drawable/vip_introduce_checked"/>
        <TextView
            android:textSize="@dimen/vip_introduce_text_size"
            android:textColor="@color/vip_introduce_message_color"
            android:id="@+id/vip_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vip_introduce_message3"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/vip_introduce_text_margin_start"/>
    </LinearLayout>
</LinearLayout>
