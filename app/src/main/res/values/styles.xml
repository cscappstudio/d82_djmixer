<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.AdAttribution" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:text">Ad</item>
        <item name="android:background">@color/black</item>
        <item name="android:width">18dp</item>
        <item name="android:height">18dp</item>
    </style>
    <style name="FXRotateStepBarStyle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="rotateStep">1</item>
        <item name="rotateStepBackgroundColor">@color/fx_seekbar_background_color</item>
        <item name="rotateStepGraduationStyle">line</item>
        <item name="rotateStepIndicatorDrawable">@drawable/fx_rotate_indicator_left</item>
        <item name="rotateStepMax">1000</item>
        <item name="rotateStepPlugPadding">@dimen/fx_rotate_bar_plug_padding</item>
        <item name="rotateStepProgress">500</item>
        <item name="rotateStepProgressColor">@color/theme_color_left</item>
        <item name="rotateStepProgressWidth">@dimen/fx_rotate_bar_progress_width</item>
    </style>

    <style name="FXRotateStepBarTextStyle" parent="">
        <item name="android:textSize">@dimen/fx_rotate_bar_text_size</item>
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/fx_rotate_bar_margin_text_margin</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SampleItemStyle" parent="">
        <item name="android:textSize">@dimen/sample_item_text_size</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="DialogTitle" parent="@android:style/Widget.Holo.Light.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
    </style>

    <style name="DialogButton" parent="@android:style/Widget.Holo.Light.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/theme_color</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
