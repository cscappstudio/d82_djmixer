<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/middle_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <include
            android:id="@+id/activity_tool_layout_left"
            android:layout_width="@dimen/tool_layout_width"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/tool_layout_margin_v"
            android:layout_marginBottom="@dimen/tool_layout_margin_v"
            android:layout_marginStart="@dimen/tool_layout_margin_left"
            android:layout_marginVertical="@dimen/tool_layout_margin_v"
            layout="@layout/activity_main_tool_layout"/>
        <FrameLayout
            android:id="@+id/container_left"
            android:background="@drawable/card_surface_bg_large"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/tool_layout_margin_v"
            android:layout_marginBottom="@dimen/tool_layout_margin_v"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">
            <include
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/layout_play_rotate"/>
        </FrameLayout>
    </LinearLayout>
    <include
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/tool_layout_margin_v"
        android:layout_marginBottom="@dimen/tool_layout_margin_v"
        layout="@layout/activity_main_sound_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/container_right"
            android:background="@drawable/card_surface_bg_large"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/tool_layout_margin_v"
            android:layout_marginBottom="@dimen/tool_layout_margin_v"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">
            <include
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/layout_play_rotate"/>
        </FrameLayout>
        <include
            android:id="@+id/activity_tool_layout_right"
            android:layout_width="@dimen/tool_layout_width"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/tool_layout_margin_v"
            android:layout_marginBottom="@dimen/tool_layout_margin_v"
            android:layout_marginEnd="@dimen/tool_layout_margin_left"
            android:layout_marginVertical="@dimen/tool_layout_margin_v"
            layout="@layout/activity_main_tool_layout"/>
    </LinearLayout>
</LinearLayout>
