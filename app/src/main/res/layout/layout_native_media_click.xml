<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="250dp"
        app:shimmer_auto_start="true">
        <include layout="@layout/ads_shimmer_native_media" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background_item"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/ad_content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:paddingTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ad_app_icon"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:adjustViewBounds="true"
                                android:paddingTop="5dp"
                                android:src="#096DD9" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="5dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/ad_headline"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:paddingTop="5dp"
                                    android:text="Sponsored Ad"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="19dp"
                                android:layout_height="15dp"
                                android:layout_gravity="bottom"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_ad_badge"
                                android:gravity="center"
                                android:text="Ad"
                                android:textColor="@color/app_main"
                                android:textSize="9sp" />
                        </FrameLayout>

                    </LinearLayout>
                </LinearLayout>

                <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                    android:id="@+id/media_view"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="5dp"
                    android:layout_gravity="center_horizontal" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/ad_call_to_action"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginVertical="5dp"
                    android:background="@drawable/bg_button_ads"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:gravity="center"
                    android:text="Install"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

        </RelativeLayout>

    </com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>

</FrameLayout>