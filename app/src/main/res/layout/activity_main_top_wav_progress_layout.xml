<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/record_wave_layout_height">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/music_key_text_size"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/key_left"
                android:visibility="gone"
                android:background="@drawable/shape_key"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="18dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/theme_color_left"
                android:paddingHorizontal="4dp"/>
            <TextView
                android:textSize="@dimen/music_title_text_size"
                android:textColor="@color/theme_color_left"
                android:ellipsize="end"
                android:id="@+id/title_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/music"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/music_duration_text_size"
                android:textColor="@color/theme_color_left"
                android:id="@+id/duration_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <com.ijoysoft.mix.view.WaveProgressView
            android:id="@+id/wave_left"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:waveWaveLineColor="@color/theme_color_left"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/record_layout"
        android:background="@drawable/record_bg"
        android:layout_width="@dimen/record_layout_width"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/record_layout_margin_h"
        android:layout_marginRight="@dimen/record_layout_margin_h"
        android:layout_marginHorizontal="@dimen/record_layout_margin_h">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/record_icon"
            android:layout_width="@dimen/record_icon_size"
            android:layout_height="@dimen/record_icon_size"
            app:srcCompat="@drawable/record_icon_selector"/>
        <TextView
            android:textSize="@dimen/record_time_text_size"
            android:textColor="@color/white"
            android:id="@+id/record_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rec"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/record_time_margin_left"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/music_key_text_size"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/key_right"
                android:visibility="gone"
                android:background="@drawable/shape_key"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="18dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/theme_color_right"
                android:paddingHorizontal="4dp"/>
            <TextView
                android:textSize="@dimen/music_title_text_size"
                android:textColor="@color/theme_color_right"
                android:ellipsize="end"
                android:id="@+id/title_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/music"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/music_duration_text_size"
                android:textColor="@color/theme_color_right"
                android:id="@+id/duration_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <com.ijoysoft.mix.view.WaveProgressView
            android:id="@+id/wave_right"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:waveWaveLineColor="@color/theme_color_right"/>
    </LinearLayout>
</LinearLayout>
