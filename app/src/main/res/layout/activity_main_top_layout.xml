<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/top_layout"
    android:background="@color/top_layout_bg_color"
    android:paddingLeft="@dimen/top_layout_padding_h"
    android:paddingTop="@dimen/top_layout_padding_top"
    android:paddingRight="@dimen/top_layout_padding_h"
    android:paddingBottom="@dimen/top_layout_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/top_layout_padding_h">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/top_layout_wave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="@dimen/pitch_btn_reset_with"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/pitch_btn_margin_h"
            android:layout_marginRight="@dimen/pitch_btn_margin_h"
            android:layout_marginHorizontal="@dimen/pitch_btn_margin_h"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/pitch_btn_wave_margin"
            android:layout_marginRight="@dimen/pitch_btn_wave_margin"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/pitch_btn_wave_margin">
            <include layout="@layout/activity_main_top_wav_progress_layout"/>
            <include layout="@layout/activity_main_top_wav_layout"/>
        </LinearLayout>
        <Space
            android:layout_width="@dimen/pitch_btn_reset_with"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/pitch_btn_margin_h"
            android:layout_marginRight="@dimen/pitch_btn_margin_h"
            android:layout_marginHorizontal="@dimen/pitch_btn_margin_h"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_layout_wave"
        app:layout_constraintEnd_toEndOf="@+id/top_layout_wave"
        app:layout_constraintStart_toStartOf="@+id/top_layout_wave"
        app:layout_constraintTop_toTopOf="@+id/top_layout_wave">
        <include
            android:id="@+id/pitch_layout_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/activity_main_top_pitch_layout_left"/>
        <Space
            android:id="@+id/placeholder_view"
            android:layout_width="@dimen/record_layout_width"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/record_layout_margin_h"
            android:layout_marginRight="@dimen/record_layout_margin_h"
            android:layout_marginHorizontal="@dimen/record_layout_margin_h"/>
        <include
            android:id="@+id/pitch_layout_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/activity_main_top_pitch_layout_right"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
