<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/tool_layout_bg"
    android:paddingLeft="@dimen/cues_layout_padding_h"
    android:paddingTop="@dimen/cues_layout_padding_v"
    android:paddingRight="@dimen/cues_layout_padding_h"
    android:paddingBottom="@dimen/cues_layout_padding_v"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/cues_layout_margin_h"
    android:layout_marginRight="@dimen/cues_layout_margin_h"
    android:layout_marginHorizontal="@dimen/cues_layout_margin_h"
    android:paddingHorizontal="@dimen/cues_layout_padding_h"
    android:paddingVertical="@dimen/cues_layout_padding_v">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cues_clear_button_margin_bottom">
        <TextView
            android:textSize="@dimen/cues_text_size"
            android:textColor="@color/primary_color"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hot_cues"
            android:fontFamily="sans-serif-medium"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/cues_clear_button_text_size"
            android:textColor="@color/cues_clear_text_color_selector_left"
            android:gravity="center"
            android:id="@+id/clear"
            android:background="@drawable/cues_clear_bg_selector_left"
            android:layout_width="@dimen/cues_clear_button_width"
            android:layout_height="@dimen/cues_clear_button_height"
            android:text="@string/clear"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            app:textAllCaps="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/cues_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/activity_main_tool_cues_layout_item"/>
        <include
            android:id="@+id/cues_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cues_item_margin"
            layout="@layout/activity_main_tool_cues_layout_item"/>
        <include
            android:id="@+id/cues_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cues_item_margin"
            layout="@layout/activity_main_tool_cues_layout_item"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cues_item_margin">
        <include
            android:id="@+id/cues_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/activity_main_tool_cues_layout_item"/>
        <include
            android:id="@+id/cues_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cues_item_margin"
            layout="@layout/activity_main_tool_cues_layout_item"/>
        <include
            android:id="@+id/cues_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cues_item_margin"
            layout="@layout/activity_main_tool_cues_layout_item"/>
    </LinearLayout>
</LinearLayout>
