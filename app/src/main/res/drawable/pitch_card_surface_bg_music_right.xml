<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border Layer (Purple Gradient Stroke) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C084FC"
                android:endColor="#80C084FC" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- Surface Fill Layer inset by 1.2dp on all sides -->
    <item
        android:bottom="1.2dp"
        android:left="1.2dp"
        android:right="1.2dp"
        android:top="1.2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1B162B" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
