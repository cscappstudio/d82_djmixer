<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="@dimen/sound_seekbar_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/sound_seekbar_visualizer_margin">
        <com.ijoysoft.mix.view.VolumeSeekBar
            android:id="@+id/seekbar_sound_left"
            android:paddingLeft="@dimen/sound_seekbar_padding_h"
            android:paddingRight="@dimen/sound_seekbar_padding_h"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/sound_seekbar_padding_h"
            app:seekProgressBgColor="@color/sound_seekbar_progress_bg_color"
            app:seekProgressColor="@color/theme_color_left"
            app:seekProgressSize="@dimen/sound_seekbar_progress_size"
            app:seekProgressThumb="@drawable/seekbar_thumb_v_selector_left"
            app:seekScaleLineColor="@color/sound_seekbar_scale_line_color"
            app:seekScaleLinePressedColor="@color/sound_seekbar_scale_line_color_pressed"
            app:seekScaleLineShortColor="@color/sound_seekbar_scale_line_color_short"
            app:seekScaleLineShortPressedColor="@color/sound_seekbar_scale_line_color_short_pressed"
            app:seekTextSize="@dimen/sound_seekbar_text_size"
            app:seekThumbEdgeAlign="true"
            app:seekThumbEdgeShadowRatio="0.1"
            app:seekVerticalMode="true"/>
        <TextView
            android:textSize="@dimen/sound_seekbar_bottom_text_size"
            android:textColor="@color/primary_color"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vol"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <com.ijoysoft.mix.view.visualizer.VisualizerView
        android:orientation="vertical"
        android:id="@+id/sound_visualizer_left"
        android:layout_width="@dimen/sound_visualizer_width"
        android:layout_height="match_parent"
        app:visualizer_gradient_colors="#A6FF56,#FFFF4F,#FFFF4F,#FF9536,#FF1B14"
        app:visualizer_line_width="0dp"
        app:visualizer_linear_color="@android:color/transparent"
        app:visualizer_overlay_color="#2C3247"
        app:visualizer_row="20"/>
    <com.ijoysoft.mix.view.visualizer.VisualizerView
        android:orientation="vertical"
        android:id="@+id/sound_visualizer_right"
        android:layout_width="@dimen/sound_visualizer_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sound_visualizer_margin_center"
        app:visualizer_gradient_colors="#A6FF56,#FFFF4F,#FFFF4F,#FF9536,#FF1B14"
        app:visualizer_line_width="0dp"
        app:visualizer_linear_color="@android:color/transparent"
        app:visualizer_overlay_color="#2C3247"
        app:visualizer_row="20"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="@dimen/sound_seekbar_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sound_seekbar_visualizer_margin">
        <com.ijoysoft.mix.view.VolumeSeekBar
            android:id="@+id/seekbar_sound_right"
            android:paddingLeft="@dimen/sound_seekbar_padding_h"
            android:paddingRight="@dimen/sound_seekbar_padding_h"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/sound_seekbar_padding_h"
            app:seekProgressBgColor="@color/sound_seekbar_progress_bg_color"
            app:seekProgressColor="@color/theme_color_right"
            app:seekProgressSize="@dimen/sound_seekbar_progress_size"
            app:seekProgressThumb="@drawable/seekbar_thumb_v_selector_right"
            app:seekScaleLineColor="@color/sound_seekbar_scale_line_color"
            app:seekScaleLinePressedColor="@color/sound_seekbar_scale_line_color_pressed"
            app:seekScaleLineShortColor="@color/sound_seekbar_scale_line_color_short"
            app:seekScaleLineShortPressedColor="@color/sound_seekbar_scale_line_color_short_pressed"
            app:seekTextSize="@dimen/sound_seekbar_text_size"
            app:seekThumbEdgeAlign="true"
            app:seekThumbEdgeShadowRatio="0.1"
            app:seekVerticalMode="true"/>
        <TextView
            android:textSize="@dimen/sound_seekbar_bottom_text_size"
            android:textColor="@color/primary_color"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vol"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
