<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ijoysoft.mix.view.WaveView
        android:id="@+id/waveView_left"
        android:paddingBottom="1px"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wave_view_height"
        app:layout_constraintBottom_toTopOf="@+id/waveView_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:wavScaleWidth="64dp"
        app:wavTopDirection="true"
        app:wavWaveLineColor="@color/theme_color_left"/>
    <com.ijoysoft.mix.view.WaveView
        android:id="@+id/waveView_right"
        android:paddingTop="1px"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wave_view_height"
        android:layout_marginTop="@dimen/wave_view_margin_v"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/waveView_left"
        app:wavScaleWidth="64dp"
        app:wavTopDirection="false"
        app:wavWaveLineColor="@color/theme_color_right"/>
    <View
        android:background="#EF4444"
        android:layout_width="1.5dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
