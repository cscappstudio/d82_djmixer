<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/tool_layout_width"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/tool_button_text_size"
        android:textStyle="bold"
        android:textColor="@color/tool_btn_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/btn_eq"
        android:background="@drawable/tool_button_bg_selector_left"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_eq"
        android:drawablePadding="2dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:text="@string/eq"
        android:layout_weight="1"
        android:textAlignment="center"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/tool_button_spacing_v"/>
    <TextView
        android:textSize="@dimen/tool_button_text_size"
        android:textStyle="bold"
        android:textColor="@color/tool_btn_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/btn_fx"
        android:background="@drawable/tool_button_bg_selector_left"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_bass"
        android:drawablePadding="2dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:text="@string/bass"
        android:layout_weight="1"
        android:textAlignment="center"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/tool_button_spacing_v"/>
    <TextView
        android:textSize="@dimen/tool_button_text_size"
        android:textStyle="bold"
        android:textColor="@color/tool_btn_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/btn_loop"
        android:background="@drawable/tool_button_bg_selector_left"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_loop"
        android:drawablePadding="2dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:text="@string/loop"
        android:layout_weight="1"
        android:textAlignment="center"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/tool_button_spacing_v"/>
    <TextView
        android:textSize="@dimen/tool_button_text_size"
        android:textStyle="bold"
        android:textColor="@color/tool_btn_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/btn_cues"
        android:background="@drawable/tool_button_bg_selector_left"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_cues"
        android:drawablePadding="2dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:text="@string/cues"
        android:layout_weight="1"
        android:textAlignment="center"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/tool_button_spacing_v"/>
    <TextView
        android:textSize="@dimen/tool_button_text_size"
        android:textStyle="bold"
        android:textColor="@color/tool_btn_text_color_selector_left"
        android:gravity="center"
        android:id="@+id/btn_samples"
        android:background="@drawable/tool_button_bg_selector_left"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:drawableTop="@drawable/ic_sampler"
        android:drawablePadding="2dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:text="@string/samples"
        android:layout_weight="1"
        android:textAlignment="center"/>
</LinearLayout>
